# DefiDesh environment variables — copy to .env.local and fill in.
# Every value below is a server-side secret unless the key is prefixed
# with NEXT_PUBLIC_ (those are inlined into the client bundle at build time).

# ── Required ────────────────────────────────────────────────────────────────

# Alchemy API key — used by the wallet-token scanner (useWalletTokens),
# Aerodrome / Uniswap V3 / Velodrome activity routes, and the wallet
# balances page for non-HyperEVM EVM chains (Ethereum, Base, Arbitrum,
# Optimism, Polygon). Sign up: https://www.alchemy.com/
# Note: this one IS exposed to the client (NEXT_PUBLIC_) because the
# Alchemy chain URLs are constructed in the browser.
NEXT_PUBLIC_ALCHEMY_KEY=

# Helius API key — used by Solana activity routes (Orca, Raydium) and
# /api/solana/balances. Server-side only. Sign up: https://helius.dev/
HELIUS_API_KEY=

# Etherscan V2 API key — used by /api/hyperswap/activity as the PRIMARY
# source for HyperEVM (chainid=999) deposit / withdrawal / fee_claim event
# logs. Etherscan V2 is archive-backed with full history, where the public
# HyperEVM RPC eth_getLogs is pruned (~5M blocks). When this key is set the
# 3-tier fallback chain is: (1) Etherscan V2 → (2) DRPC eth_getLogs over the
# last 5M blocks → (3) `buildFallbackPnL` current-value-as-estimate in
# app/hooks/useLpPnl.ts. When unset, tier 1 is skipped and the route starts
# at tier 2. One free Etherscan V2 key works across all 64 supported chains.
# Sign up: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# WalletConnect project id — enables the WalletConnect QR connect option
# in the homepage EVM wallet picker. Without this, WalletConnect is
# omitted gracefully. Get one at: https://cloud.reown.com/
NEXT_PUBLIC_WC_PROJECT_ID=

# Custom Sui RPC URL — defaults to the public RPC if unset.
SUI_RPC_URL=

# Vercel Postgres / Neon — currently unused (the DB-backed snapshot
# system was removed). Routes gracefully return `db_not_configured`.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Vercel cron auth — auto-injected by Vercel when a cron job runs;
# set locally only if you want to exercise the protected cron endpoint.
CRON_SECRET=
